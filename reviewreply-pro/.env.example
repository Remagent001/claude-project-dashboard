# ─────────────────────────────────────────────────────────────
# ReviewReply Pro — environment variables
# Copy this file to `.env` and fill in your values.  NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Database (Postgres) ──────────────────────────────────────
# On Vercel: add a Postgres store and these TWO variables are set for you
# automatically — you don't type them in.
#
# For LOCAL development, set both to your Postgres connection string
# (they can be identical locally):
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# ── AI provider ──────────────────────────────────────────────
# Which AI provider to use: "anthropic" or "openai".
# The app has an abstraction layer so you can swap providers without code changes.
# Leave blank to run the built-in offline template generator (no key needed).
AI_PROVIDER="anthropic"

# Anthropic (Claude) — https://console.anthropic.com/
# >>> INSERT YOUR ANTHROPIC API KEY HERE <<<
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# OpenAI (GPT) — https://platform.openai.com/
# >>> INSERT YOUR OPENAI API KEY HERE (only if AI_PROVIDER=openai) <<<
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# If NEITHER AI key is set, the app falls back to a built-in deterministic
# template generator so you can demo the full UI/flow with no API key.
