# ─────────────────────────────────────────────────────────────
# ReviewReply Pro — environment variables
# Copy this file to `.env` and fill in your keys.  NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Local SQLite database (Prisma). No need to change for local dev.
DATABASE_URL="file:./dev.db"

# Which AI provider to use: "anthropic" or "openai".
# The app has an abstraction layer so you can swap providers without code changes.
AI_PROVIDER="anthropic"

# ── Anthropic (Claude) ───────────────────────────────────────
# Get a key at https://console.anthropic.com/
# >>> INSERT YOUR ANTHROPIC API KEY HERE <<<
ANTHROPIC_API_KEY=""
# Optional model override. Defaults to a current Claude model if unset.
ANTHROPIC_MODEL="claude-sonnet-5"

# ── OpenAI (GPT) ─────────────────────────────────────────────
# Get a key at https://platform.openai.com/
# >>> INSERT YOUR OPENAI API KEY HERE (only if AI_PROVIDER=openai) <<<
OPENAI_API_KEY=""
# Optional model override. Defaults to gpt-4o if unset.
OPENAI_MODEL="gpt-4o"

# If NEITHER key is set, the app falls back to a built-in deterministic
# template generator so you can demo the full UI/flow with no API key.
